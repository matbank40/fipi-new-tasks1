# токен от @BotFather
BOT_TOKEN=123456:ABC...
# твой Telegram id (узнать: @userinfobot), можно несколько через запятую
ADMIN_IDS=111111111
# необязательно: канал для постинга (бот — админ канала), например @fipi_new или -100...
CHANNEL_ID=
# раз в сколько часов проходить банки целиком
SCAN_EVERY_HOURS=6
# пауза между запросами к ФИПИ (не ставь меньше 1)
REQUEST_DELAY=1.5
PAGE_SIZE=50
MAX_NEW_PER_SCAN=120
# если ФИПИ ругается на сертификат — поставь 0
FIPI_VERIFY_SSL=1
# если Telegram с сервера недоступен — одно из двух:
# TG_PROXY=socks5://user:pass@host:port
# TG_API_BASE=https://имя.workers.dev
TG_PROXY=
TG_API_BASE=https://api.telegram.org
